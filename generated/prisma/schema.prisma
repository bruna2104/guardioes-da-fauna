// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  CITIZEN
  VOLUNTEER
  NGO_ADMIN
  ADMIN
}

enum RescueStatus {
  REPORTED // Registrado aguardando resgate
  IN_PROGRESS // Voluntário/ONG a caminho ou em atendimento
  RESCUED // Animal seguro e recebendo cuidados
  READY_ADOPTION // Recuperado e disponível para adoção
  RESOLVED // Caso finalizado/adotado
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// --- AUTH & USUÁRIOS ---

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  city          String?
  state         String?
  role          Role      @default(CITIZEN)

  ngoId String?
  ngo   Ngo?    @relation(fields: [ngoId], references: [id])

  accounts  Account[]
  sessions  Session[]
  posts     Post[]
  rescues   RescueCase[]
  donations Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

// --- ONGS PARCEIRAS ---

model Ngo {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  cnpj        String? @unique
  description String
  logo        String?
  coverImage  String?
  phone       String
  email       String
  pixKey      String?
  city        String
  state       String
  isVerified  Boolean @default(false)

  members   User[]
  rescues   RescueCase[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- RESGATES E ANIMAIS ---

model RescueCase {
  id          String       @id @default(cuid())
  title       String
  description String
  species     String // Cão, Gato, Silvestre, etc.
  urgency     UrgencyLevel @default(MEDIUM)
  status      RescueStatus @default(REPORTED)

  city    String
  state   String
  address String?
  photos  String[] // Array de URLs de imagens

  reportedById String
  reportedBy   User   @relation(fields: [reportedById], references: [id])

  assignedNgoId String?
  assignedNgo   Ngo?    @relation(fields: [assignedNgoId], references: [id])

  campaign Campaign?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, state])
  @@index([status])
}

// --- DOAÇÕES E CAMPANHAS ---

model Campaign {
  id            String         @id @default(cuid())
  title         String
  description   String
  goalAmount    Float
  currentAmount Float          @default(0)
  status        CampaignStatus @default(ACTIVE)

  ngoId String
  ngo   Ngo    @relation(fields: [ngoId], references: [id])

  rescueCaseId String?     @unique
  rescueCase   RescueCase? @relation(fields: [rescueCaseId], references: [id])

  donations Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id            String @id @default(cuid())
  amount        Float
  paymentMethod String // PIX, CREDIT_CARD
  paymentStatus String // PENDING, COMPLETED, FAILED

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
